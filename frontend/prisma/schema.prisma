// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth models for NextAuth.js
model Session {
  id              String            @id @default(cuid())
  sessionToken    String            @unique
  companyId       String
  expires         DateTime
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessionTableData SessionTableData[]
  searchQueries   SearchQuery[]
  rfps            RFP[]
  createdAt       DateTime          @default(now())

  @@index([companyId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Main application models
model Company {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  email     String    @unique
  password  String    // hashed
  industry  String?
  city      String?
  state     String?
  country   String?
  sessions  Session[]
  rfps      RFP[]
  searchQueries SearchQuery[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Supplier database (separate from products)
model Supplier {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique // URL-friendly version (e.g., "acme-corp" for profile URLs)
  contactEmail        String    @unique // Required for authentication
  password            String    // Hashed password for supplier login (required)
  industry            String?
  website             String?
  contactPhone        String?
  address             String?
  city                String?
  state               String?
  country             String?
  certificationsJson  Json?     @db.JsonB  // ISO, CE, etc.
  rating              Float?    @default(0)
  verified            Boolean   @default(false)
  description         String?   @db.Text
  products            Product[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([name])
  @@index([contactEmail])
  @@index([slug])
  @@index([country])
  @@index([verified])
}

// Products linked to Suppliers (relational)
model Product {
  id                  String    @id @default(cuid())
  supplier            Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId          String
  name                String
  sku                 String?
  mpn                 String?
  priceText           String?
  currency            String?
  unit                String?
  specsJson           Json?     @db.JsonB
  certificationsJson  Json?     @db.JsonB
  sourceUrl           String?
  imageUrl            String?
  description         String?   @db.Text
  lastSeenAt          DateTime  @default(now())
  score               Float?
  inStock             Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([supplierId])
  @@index([name])
  @@index([sku])
  @@index([mpn])
  @@index([inStock])
}

// Session-based table data storage (for persisting UI state)
model SessionTableData {
  id            String   @id @default(cuid())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  tableKey      String   // e.g., "product_search_results", "rfp_list", "supplier_list"
  data          Json     @db.JsonB  // Stores table rows, filters, sort, pagination state
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sessionId])
  @@index([tableKey])
  @@unique([sessionId, tableKey])
}

model SearchQuery {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId   String?
  query       String
  filtersJson Json?    @db.JsonB
  resultsCount Int?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([sessionId])
}

model RFP {
  id           String     @id @default(cuid())
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  session      Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId    String?
  supplierId   String?    // Link to supplier if RFP is for internal supplier
  supplierName String?    // Store supplier name for display (even if not internal)
  title        String
  bodyMd       String     @db.Text
  draftJson    Json       @db.JsonB
  status       String     @default("draft") // draft, published, archived
  pdfContent   Bytes?     // Store PDF binary content
  htmlContent  String?    @db.Text // Store HTML version for viewing
  filename     String?    // Original filename for downloads
  shares       RFPShare[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([companyId])
  @@index([sessionId])
  @@index([status])
  @@index([supplierId])
}

model RFPShare {
  id        String    @id @default(cuid())
  rfp       RFP       @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  rfpId     String
  linkToken String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([rfpId])
  @@index([linkToken])
}
